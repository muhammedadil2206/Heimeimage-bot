{
  "name": "heimage-bot",
  "version": "1.0.0",
  "description": "Full-stack text-to-image generator using Clipdrop API",
  "private": true,
  "scripts": {
    "start": "node start.js",
    "dev": "npm run start",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "build:server": "cd server && npm install"
  },
  "keywords": [
    "text-to-image",
    "clipdrop",
    "mern",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Muhammed Adil",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
